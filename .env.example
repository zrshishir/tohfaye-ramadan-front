# API base URL — must include the /api suffix.
# Production:
VITE_BASE_URL=https://prayerpulse.tazqiah.com/api
# Local development against a Laravel backend, e.g.:
# VITE_BASE_URL=http://127.0.0.1:8000/api

# Google Maps Geocoding API key, used by HeaderArea.vue for reverse geocoding.
# Restrict this key by HTTP referrer / app bundle id before shipping.
VITE_BASE_KEY=
